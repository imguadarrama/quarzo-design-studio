generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id        String           @id @default(cuid())
  name      String           @unique
  slug      String           @unique
  position  Int              @default(0)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  products  Product[]
  designs   DesignCategory[]

  @@index([active])
}

model Product {
  id          String                @id @default(cuid())
  slug        String                @unique
  name        String
  description String
  categoryId  String
  category    Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  variants    ProductVariantPrice[]
  designs     ProductDesign[]
  slugAliases ProductSlugAlias[]
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())

  @@index([categoryId])
  @@index([active])
}

model ProductVariantPrice {
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      VariantKind
  price     Decimal     @db.Decimal(10, 2)
  sku       String      @unique
  offered   Boolean     @default(true)

  @@id([productId, kind])
  @@index([productId])
}

model Design {
  id         String                @id @default(cuid())
  name       String
  imageUrl   String
  position   Int                   @default(0)
  active     Boolean               @default(true)
  createdAt  DateTime              @default(now())
  compat     DesignVariantCompat[]
  products   ProductDesign[]
  categories DesignCategory[]

  @@index([active])
}

model DesignVariantCompat {
  designId String
  design   Design      @relation(fields: [designId], references: [id], onDelete: Cascade)
  kind     VariantKind

  @@id([designId, kind])
}

model DesignCategory {
  designId   String
  categoryId String
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([designId, categoryId])
  @@index([categoryId])
}

model ProductDesign {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  designId  String
  design    Design  @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@id([productId, designId])
  @@index([designId])
}

model ProductSlugAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  slug      String   @unique
  createdAt DateTime @default(now())

  @@index([productId])
}

model OptionPalette {
  id       String         @id @default(cuid())
  name     String         @unique
  slug     String         @unique
  position Int            @default(0)
  active   Boolean        @default(true)
  swatches OptionSwatch[]

  @@index([active])
}

model OptionSwatch {
  id        String        @id @default(cuid())
  paletteId String
  palette   OptionPalette @relation(fields: [paletteId], references: [id], onDelete: Cascade)
  name      String
  imageUrl  String
  position  Int           @default(0)
  active    Boolean       @default(true)

  @@unique([paletteId, name])
  @@index([paletteId])
  @@index([active])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
}

model Order {
  id              String         @id @default(cuid())
  publicToken     String         @unique
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id])
  email           String
  name            String
  phone           String
  shippingMethod  ShippingMethod
  shippingAddress Json?
  shippingFee     Decimal        @db.Decimal(10, 2) @default(0)
  subtotal        Decimal        @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  status          OrderStatus    @default(PENDIENTE)
  mpPreferenceId  String?
  mpPaymentId     String?
  notes           String?
  items           OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                  String      @id @default(cuid())
  orderId             String
  order               Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  variantKind         VariantKind
  sku                 String?
  productName         String
  variantName         String
  unitPrice           Decimal     @db.Decimal(10, 2)
  quantity            Int
  personalizationText String
  selections          Json
  designId            String?
  designName          String?
  designImageUrl      String?

  @@index([orderId])
}

enum ShippingMethod {
  NACIONAL
  PICKUP_SALTILLO
}

enum PaymentMethod {
  MERCADOPAGO
  TRANSFERENCIA
}

enum OrderStatus {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum VariantKind {
  CON_FOIL
  CON_TINTA_NORMAL
  CON_FOIL_Y_TINTA
  PAPEL_TEXTURIZADO
}
