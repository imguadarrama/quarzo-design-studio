{
  "name": "quarzo-design-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "docker compose up",
    "dev:down": "docker compose down",
    "dev:rebuild": "docker compose up --build",
    "server": "pnpm --filter server",
    "client": "pnpm --filter client",
    "seed": "docker compose exec api pnpm --filter server seed",
    "migrate": "docker compose run --rm api pnpm --filter server exec prisma migrate dev"
  }
}
