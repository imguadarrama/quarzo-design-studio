# Postgres (used by both the `db` service and the `api` service)
POSTGRES_USER=quarzo
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=quarzo

# Connection string consumed by Prisma inside the `api` container.
# Host `db` resolves via the docker-compose network.
DATABASE_URL=postgresql://quarzo:change-me-in-local-env@db:5432/quarzo?schema=public

# API
# APP_ENV is the deploy-env signal used by app code (development | staging | production).
# NODE_ENV stays "production" in both staging and prod deploys so libraries behave correctly.
APP_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Optional regex (staging only) to allow Cloudflare Pages preview URLs through CORS.
# Leave empty in development and production. Example staging value:
#   ^https://[a-z0-9-]+\.quarzo-staging\.pages\.dev$
CLIENT_ORIGIN_PREVIEW_PATTERN=
COOKIE_DOMAIN=localhost
JWT_SECRET=replace-with-a-long-random-string
ADMIN_AUTH_COOKIE_NAME=quarzo_admin_session
CUSTOMER_AUTH_COOKIE_NAME=quarzo_customer_session
AUTH_TOKEN_TTL_HOURS=12

# Admin user seeded by `pnpm seed`
ADMIN_EMAIL=admin@quarzo.local
ADMIN_PASSWORD=change-me-in-local-env

# Cloudflare R2 (Phase 2.6 — product image storage)
# Local dev uses the *staging* bucket: the staging token is scoped to
# quarzo-media-staging only, so a local mistake cannot touch prod.
# Provisioning walkthrough: docs/phase-2.6-execution-plan.md §3.0.
# CLOUDFLARE_ACCOUNT_ID is the Cloudflare account ID — same value as the
# GitHub secret of the same name. The access key + secret are captured
# once when creating the `quarzo-r2-rw-staging` token; if lost, delete
# and recreate the token. R2_PUBLIC_BASE_URL is the pub-<hash>.r2.dev URL
# CF shows after enabling public access on the bucket.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quarzo-media-staging
R2_PUBLIC_BASE_URL=
# Optional. When set, every R2 key is prefixed with this segment so per-PR
# uploads can be cleanly purged on PR close (cleanup-staging.yml deletes
# everything under `pr-<N>/`). Prod leaves this empty; deploy-staging.yml
# sets it to `pr-<N>` per-PR. Leave blank locally unless you want to
# isolate your dev uploads.
R2_KEY_PREFIX=
